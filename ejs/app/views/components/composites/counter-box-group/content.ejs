            <img src="<%= image1 %>" alt="<%= t.components.composites.counterBox.alt %>">
        </div>

        <div class="d-flex flex-column txt-align-justify">
            
            <%- include('../../interactives/view/content.ejs', {
                value: value1 ,
                suffix: suffix1
            }); -%>   

